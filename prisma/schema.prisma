generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  ACCOUNTANT
  SALES_MANAGER
  VIEWER
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

/// NextAuth models — extended with orgId for multi-tenancy
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  phone         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orgId String?
  role  Role          @default(VIEWER)
  org   Organization? @relation(fields: [orgId], references: [id])

  accounts    Account[]
  sessions    Session[]
  invoices    Invoice[]
  tenantUsers TenantUser[]
  proformaInvoices ProformaInvoice[]
  expenses         Expense[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Multi-tenant organization model
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  currency  String   @default("INR")
  gstin     String?
  address   String?
  phone     String?
  email     String?
  website   String?
  upiId     String?
  plan      String   @default("free")
  settings  String   @default("{}")

  // Branding fields (Phase 17)
  primaryColor        String   @default("#06b6d4")
  fontFamily          String   @default("Inter")
  poweredByBizzBills  Boolean  @default(true)
  customFields        String   @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches        Branch[]
  tenants         TenantUser[]
  invoices        Invoice[]
  subscriptions   Subscription[]
  plans           Plan[]
  users           User[]
  chartOfAccounts ChartOfAccount[]
  journalEntries  JournalEntry[]
  ledgers         Ledger[]
  gstRates        GstRate[]
  ewayBills       EwayBill[]
  hsnSacCodes     HsnSacCode[]
  aiConfig        AIConfig?
  exchangeRates   CurrencyExchangeRate[]
  payments        Payment[]
  creditNotes     CreditNote[]
  debitNotes      DebitNote[]
  recurringInvoices RecurringInvoice[]
  reminderSetting ReminderSetting?
  products        Product[]
  warehouses      Warehouse[]
  inventoryItems  InventoryItem[]
  stockMovements  StockMovement[]
  parties         Party[]
  orders          Order[]
  bankAccounts    BankAccount[]
  bankTransactions BankTransaction[]
  paymentReceipts PaymentReceipt[]
  activityLogs    ActivityLog[]
  employees       Employee[]
  payrollRuns     PayrollRun[]
  proformaInvoices ProformaInvoice[]
  expenses         Expense[]
  priceLists       PriceList[]
  discounts        Discount[]
  tdsEntries       TdsEntry[]
  budgets          Budget[]
  rolePermissions  RolePermission[]
  batches          Batch[]
  documents        Document[]
}

/// Granular role-based permissions — per-org, per-role
model RolePermission {
  id          String   @id @default(cuid())
  orgId       String
  role        String   // Role enum value as string
  permission  String   // e.g. "invoices.create", "invoices.delete", "reports.view"
  allowed     Boolean  @default(true)
  createdAt   DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, role, permission])
  @@index([orgId])
}

/// Branch/location within an organization
model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String?
  city      String?
  state     String?
  pincode   String?
  gstin     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  invoices Invoice[]

  @@index([orgId])
}

/// TenantUser links a User to an Organization with a specific role
model TenantUser {
  id       String   @id @default(cuid())
  userId   String
  orgId    String
  role     Role     @default(VIEWER)
  joinedAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

/// Subscription plan definition
model Plan {
  id           String   @id @default(cuid())
  orgId        String
  name         String
  price        Float    @default(0)
  billingCycle String   @default("monthly") // monthly, annual
  features     String   @default("[]") // JSON array of feature names
  maxUsers     Int      @default(1)
  maxOrgs      Int      @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

/// Active subscription for an organization
model Subscription {
  id                 String    @id @default(cuid())
  orgId              String
  planId             String
  status             String    @default("active") // active, past_due, cancelled, trial
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  startedAt          DateTime  @default(now())
  endedAt            DateTime?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

/// Application models — org-scoped
model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String
  customerName  String
  customerGstin String   @default("")
  currency      String   @default("INR")
  date          String   @default("")
  dueDate       String
  status        String   @default("draft")
  subtotal      Float    @default(0)
  taxTotal      Float    @default(0)
  total         Float    @default(0)
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Extended fields for complete invoice
  customerAddress   String   @default("")
  customerEmail     String   @default("")
  customerPhone     String   @default("")
  customerState     String   @default("")
  shippingSameAsBilling Boolean @default(true)
  shippingName      String   @default("")
  shippingAddress   String   @default("")
  shippingPhone     String   @default("")
  poNumber          String   @default("")
  referenceNumber   String   @default("")
  placeOfSupply     String   @default("")
  reverseCharge     Boolean  @default(false)
  notes             String   @default("")
  terms             String   @default("")
  discountPercent   Float    @default(0)
  discountAmount    Float    @default(0)
  shippingCharges   Float    @default(0)
  adjustment        Float    @default(0)
  bankName          String   @default("")
  bankAccountName   String   @default("")
  bankAccountNumber String   @default("")
  bankIfsc          String   @default("")
  bankBranch        String   @default("")
  upiId             String   @default("")
  signatureName     String   @default("")
  signatureDesignation String @default("")
  isTaxInclusive     Boolean  @default(false)
  roundOff          Float    @default(0)
  amountInWords     String   @default("")

  approvalStatus  String    @default("draft") // draft, pending_approval, approved, rejected
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?

  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId    String?
  org      Organization?    @relation(fields: [orgId], references: [id])
  branchId String?
  branch   Branch?          @relation(fields: [branchId], references: [id])
  ewayBillId String?
  payments   Payment[]
  lines    InvoiceLine[]
  versions InvoiceVersion[]
  creditNotes CreditNote[]
  debitNotes  DebitNote[]

  @@unique([orgId, invoiceNumber])
  @@index([userId])
  @@index([orgId])
  @@index([orgId, status])
  @@index([branchId])
}

model InvoiceLine {
  id          String @id @default(cuid())
  description String
  quantity    Float
  unitPrice   Float
  taxRate     Float  @default(0)
  discount    Float  @default(0)
  hsnCode     String  @default("")

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model InvoiceVersion {
  id            String   @id @default(cuid())
  version       Int
  snapshot      String
  changeComment String   @default("")
  createdAt     DateTime @default(now())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, version])
  @@index([invoiceId])
}

/// Double-entry bookkeeping models

/// Chart of accounts — the complete list of accounts for an organization
model ChartOfAccount {
  id        String      @id @default(cuid())
  orgId     String
  code      String
  name      String
  type      AccountType
  parentId  String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  org            Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent         ChartOfAccount?    @relation("AccountHierarchy", fields: [parentId], references: [id])
  children       ChartOfAccount[]   @relation("AccountHierarchy")
  journalEntries JournalEntryLine[]
  ledgerEntries  Ledger[]

  @@unique([orgId, code])
  @@index([orgId])
  @@index([parentId])
}

/// A journal entry — the core double-entry transaction record
model JournalEntry {
  id          String   @id @default(cuid())
  orgId       String
  entryNumber String
  date        DateTime
  description String
  reference   String?
  isPosted    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org     Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lines   JournalEntryLine[]
  ledgers Ledger[]

  @@index([orgId])
  @@index([orgId, date])
}

/// A single line within a journal entry (debit or credit)
model JournalEntryLine {
  id             String   @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Float    @default(0)
  credit         Float    @default(0)
  description    String   @default("")
  createdAt      DateTime @default(now())

  journalEntry JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      ChartOfAccount @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
}

/// Running balance ledger for each account
model Ledger {
  id             String   @id @default(cuid())
  orgId          String
  accountId      String
  entryDate      DateTime
  JournalEntryId String?
  description    String   @default("")
  debit          Float    @default(0)
  credit         Float    @default(0)
  balance        Float    @default(0)
  createdAt      DateTime @default(now())

  org          Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account      ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry?  @relation(fields: [JournalEntryId], references: [id])

  @@index([orgId])
  @@index([accountId])
  @@index([orgId, accountId, entryDate])
}

/// GST compliance models

/// Configurable GST rates for the organization
model GstRate {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  rate      Float
  type      String   @default("sgst")
  state     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@index([orgId])
}

/// E-Way Bill (Electronic Way Bill) for GST transit
model EwayBill {
  id            String   @id @default(cuid())
  orgId         String
  invoiceId     String?  @unique
  ewbNumber     String   @unique
  ewbDate       DateTime
  fromAddress   String
  toAddress     String
  transportMode String   @default("road")
  vehicleNumber String?
  distance      Float    @default(0)
  status        String   @default("generated")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

/// HSN/SAC code catalog for GST classification
model HsnSacCode {
  id          String   @id @default(cuid())
  orgId       String
  code        String
  description String
  type        String   @default("hsn")
  taxRate     Float
  chapter     String?
  heading     String?
  subheading  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, code])
  @@index([orgId])
  @@index([orgId, type])
}

/// Encrypted AI provider configurations per organization
model AIConfig {
  id        String   @id @default(cuid())
  orgId     String   @unique
  provider  String   @default("openai") // openai | anthropic
  apiKeyEncrypted String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

/// Exchange rates for multi-currency support
model CurrencyExchangeRate {
  id        String   @id @default(cuid())
  orgId     String
  fromCurrency String @default("INR")
  toCurrency   String
  rate      Float
  date      DateTime @default(now())
  source    String   @default("manual") // manual | api
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, fromCurrency, toCurrency])
  @@index([orgId])
}

/// Recurring invoice — auto-generate invoices on a schedule
model RecurringInvoice {
  id              String   @id @default(cuid())
  orgId           String
  customerName    String
  customerGstin   String   @default("")
  currency        String   @default("INR")
  frequency       String   @default("monthly") // daily, weekly, monthly, quarterly, yearly
  interval        Int      @default(1)
  startDate       DateTime
  endDate         DateTime?
  nextRunDate     DateTime
  lastRunAt       DateTime?
  status          String   @default("active") // active, paused, completed, cancelled
  subtotal        Float    @default(0)
  taxTotal        Float    @default(0)
  total           Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  lines       RecurringInvoiceLine[]
  invoiceIds  String @default("[]") // JSON array of generated invoice IDs

  @@index([orgId])
  @@index([orgId, status])
  @@index([nextRunDate])
}

model RecurringInvoiceLine {
  id          String @id @default(cuid())
  description String
  quantity    Float
  unitPrice   Float
  taxRate     Float  @default(0)
  hsnCode     String @default("")

  recurringInvoiceId String
  recurringInvoice   RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)

  @@index([recurringInvoiceId])
}

/// Product master catalog for inventory
model Product {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  description String   @default("")
  sku         String   @default("")
  hsnCode     String   @default("")
  unit        String   @default("pcs") // pcs, kg, meter, box, etc.
  sellingPrice Float   @default(0)
  purchasePrice Float  @default(0)
  taxRate     Float    @default(0)
  category    String   @default("")
  brand       String   @default("")
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org        Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  inventory  InventoryItem[]
  movements  StockMovement[]
  batches    Batch[]

  @@unique([orgId, sku])
  @@index([orgId])
  @@index([orgId, category])
}

/// Warehouse / storage location
model Warehouse {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  address   String   @default("")
  city      String   @default("")
  state     String   @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org       Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  inventory InventoryItem[]
  stockMovements StockMovement[]

  @@unique([orgId, name])
  @@index([orgId])
}

/// Stock level per product per warehouse
model InventoryItem {
  id          String   @id @default(cuid())
  orgId       String
  productId   String
  warehouseId String
  quantity    Float    @default(0)
  minStock    Float    @default(0) // low-stock threshold
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([orgId, productId, warehouseId])
  @@index([orgId])
  @@index([productId])
  @@index([warehouseId])
}

/// Stock movement log (in/out/transfer/adjustment)
model StockMovement {
  id          String   @id @default(cuid())
  orgId       String
  productId   String
  warehouseId String
  type        String   @default("in") // in, out, transfer, adjustment
  quantity    Float
  reference   String   @default("") // invoice number, order number, etc.
  notes       String   @default("")
  createdAt   DateTime @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse    @relation(fields: [warehouseId], references: [id])

  @@index([orgId])
  @@index([productId])
  @@index([warehouseId])
  @@index([createdAt])
}

/// Order — sales order, purchase order, quotation, delivery challan
model Order {
  id             String   @id @default(cuid())
  orgId          String
  orderNumber    String
  orderType      String   @default("sales_order") // sales_order, purchase_order, quotation, delivery_challan
  status         String   @default("draft") // draft, pending, approved, delivered, completed, cancelled
  partyId        String?
  partyName      String   @default("")
  partyGstin     String   @default("")
  currency       String   @default("INR")
  orderDate      DateTime
  deliveryDate   DateTime?
  subtotal       Float    @default(0)
  taxTotal       Float    @default(0)
  total          Float    @default(0)
  notes          String   @default("")
  convertedToInvoiceId String?
  approvalStatus  String    @default("draft") // draft, pending_approval, approved, rejected
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  lines OrderLine[]

  @@unique([orgId, orderNumber])
  @@index([orgId])
  @@index([orgId, orderType])
  @@index([orgId, status])
}

model OrderLine {
  id          String @id @default(cuid())
  description String
  quantity    Float
  unitPrice   Float
  taxRate     Float  @default(0)
  hsnCode     String @default("")
  productId   String? // optional link to product master

  orderId String
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// Bank account for reconciliation
model BankAccount {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  accountNumber String @default("")
  bankName  String   @default("")
  ifscCode  String   @default("")
  branch    String   @default("")
  type      String   @default("savings") // savings, current, credit_card, loan
  openingBalance Float @default(0)
  currentBalance Float @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org          Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@unique([orgId, name])
  @@index([orgId])
}

/// Bank transaction — persisted reconciliation record
model BankTransaction {
  id              String    @id @default(cuid())
  orgId           String
  bankAccountId   String
  date            DateTime
  description     String
  amount          Float
  type            String    // "credit" | "debit"
  reference       String    @default("")
  status          String    @default("unmatched") // unmatched, matched, reconciled
  matchedPaymentId String?
  reconciledAt    DateTime?
  createdAt       DateTime  @default(now())

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([bankAccountId])
  @@index([orgId, status])
  @@index([matchedPaymentId])
}

/// Payment receipt for printing
model PaymentReceipt {
  id          String   @id @default(cuid())
  orgId       String
  receiptNumber String
  paymentId   String
  receiptDate DateTime
  notes       String   @default("")
  createdAt   DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, receiptNumber])
  @@index([orgId])
}

/// Party — customer / vendor / other
model Party {
  id        String   @id @default(cuid())
  orgId     String
  type      String   @default("customer") // customer, vendor, other
  name      String
  gstin     String   @default("")
  email     String   @default("")
  phone     String   @default("")
  creditLimit Float  @default(0)
  outstandingBalance Float @default(0)
  notes     String   @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  addresses PartyAddress[]

  @@unique([orgId, name])
  @@index([orgId])
  @@index([orgId, type])
}

model PartyAddress {
  id        String @id @default(cuid())
  partyId   String
  type      String @default("billing") // billing, shipping, both
  address   String @default("")
  city      String @default("")
  state     String @default("")
  pincode   String @default("")
  isDefault Boolean @default(true)

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
}

/// Employee for payroll
model Employee {
  id            String   @id @default(cuid())
  orgId         String
  code          String   // employee code
  name          String
  email         String?
  phone         String?
  department    String   @default("")
  designation   String   @default("")
  doj           DateTime? // date of joining
  salary        Float    @default(0)
  bankName      String   @default("")
  accountNumber String   @default("")
  ifscCode      String   @default("")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  payrollRuns     PayrollRun[]

  @@unique([orgId, code])
  @@index([orgId])
}

/// Payroll run records
model PayrollRun {
  id          String   @id @default(cuid())
  orgId       String
  month       Int      // 1-12
  year        Int
  employeeId  String
  grossPay    Float
  deductions  Float    @default(0)
  netPay      Float
  status      String   @default("draft") // draft, paid, cancelled
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee Employee     @relation(fields: [employeeId], references: [id])

  @@unique([orgId, employeeId, month, year])
  @@index([orgId, month, year])
}

/// Activity log for audit trail
model ActivityLog {
  id        String   @id @default(cuid())
  orgId     String
  userId    String?
  action    String   // create, update, delete, login, export
  entity    String   // invoice, payment, product, party, etc.
  entityId  String?
  details   String   @default("") // JSON metadata
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orgId, createdAt])
  @@index([orgId, entity])
}

/// Reminder configuration for overdue invoices
model ReminderSetting {
  id               String   @id @default(cuid())
  orgId            String   @unique
  enabled          Boolean  @default(true)
  daysBefore       Int      @default(3)
  sendToCustomer   Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}
model Payment {
  id              String   @id @default(cuid())
  orgId           String
  invoiceId       String?
  amount          Float
  currency        String   @default("INR")
  method          String   @default("upi") // upi, bank_transfer, cash, cheque, card, gateway
  status          String   @default("pending") // pending, completed, failed, refunded
  gatewayRef      String?  // Razorpay/Stripe payment ID
  upiTransactionId String?
  notes           String?
  paidAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoice Invoice?     @relation(fields: [invoiceId], references: [id])

  @@index([orgId])
  @@index([invoiceId])
}

/// Credit note — sales return / credit to customer
model CreditNote {
  id              String   @id @default(cuid())
  creditNoteNumber String
  orgId           String
  invoiceId       String?
  customerName    String
  customerGstin   String   @default("")
  currency        String   @default("INR")
  reason          String   @default("return")
  subtotal        Float    @default(0)
  taxTotal        Float    @default(0)
  total           Float    @default(0)
  status          String   @default("draft")
  date            DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org     Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoice Invoice?      @relation(fields: [invoiceId], references: [id])

  lines    CreditNoteLine[]

  @@index([orgId])
  @@index([invoiceId])
}

model CreditNoteLine {
  id          String @id @default(cuid())
  description String
  quantity    Float
  unitPrice   Float
  taxRate     Float  @default(0)
  hsnCode     String @default("")

  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@index([creditNoteId])
}

/// Debit note — purchase return / debit from supplier
model DebitNote {
  id            String   @id @default(cuid())
  debitNoteNumber String
  orgId         String
  invoiceId     String?
  supplierName  String
  supplierGstin String   @default("")
  currency      String   @default("INR")
  reason        String   @default("return")
  subtotal      Float    @default(0)
  taxTotal      Float    @default(0)
  total         Float    @default(0)
  status        String   @default("draft")
  date          DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org     Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoice Invoice?      @relation(fields: [invoiceId], references: [id])

  lines    DebitNoteLine[]

  @@index([orgId])
  @@index([invoiceId])
}

model DebitNoteLine {
  id          String @id @default(cuid())
  description String
  quantity    Float
  unitPrice   Float
  taxRate     Float  @default(0)
  hsnCode     String @default("")

  debitNoteId String
  debitNote   DebitNote @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)

  @@index([debitNoteId])
}

model ProformaInvoice {
  id              String   @id @default(cuid())
  proformaNumber  String
  customerName    String
  customerGstin   String   @default("")
  currency        String   @default("INR")
  validUntil      String   @default("")
  status          String   @default("draft")
  subtotal        Float    @default(0)
  taxTotal        Float    @default(0)
  total           Float    @default(0)
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String?
  org    Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  lines ProformaInvoiceLine[]

  @@unique([orgId, proformaNumber])
  @@index([orgId])
  @@index([userId])
}

model ProformaInvoiceLine {
  id                String  @id @default(cuid())
  description       String
  quantity          Float
  unitPrice         Float
  taxRate           Float   @default(0)
  hsnCode           String  @default("")
  proformaInvoiceId String
  proformaInvoice   ProformaInvoice @relation(fields: [proformaInvoiceId], references: [id], onDelete: Cascade)

  @@index([proformaInvoiceId])
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  category    String   @default("other")
  date        String
  paymentMethod String  @default("cash")
  notes       String   @default("")
  isRecurring Boolean  @default(false)
  recurringId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String?
  org    Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId])
  @@index([category])
}

/// Price list — named catalog of product prices for an organization
model PriceList {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  description String   @default("")
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  items PriceListItem[]

  @@unique([orgId, name])
  @@index([orgId])
}

/// Individual line item within a price list
model PriceListItem {
  id          String  @id @default(cuid())
  priceListId String
  productId   String?
  productName String
  sku         String  @default("")
  unitPrice   Float
  minQuantity Float   @default(1)
  maxQuantity Float?

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@index([priceListId])
}

/// Discount — percentage, fixed, or buy-x-get-y promotions
model Discount {
  id          String    @id @default(cuid())
  orgId       String
  name        String
  type        String    @default("percentage") // percentage, fixed, buy_x_get_y
  value       Float
  minAmount   Float     @default(0)
  minQuantity Float     @default(1)
  maxUses     Int?
  usedCount   Int       @default(0)
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orgId, isActive])
}

/// TDS (Tax Deducted at Source) entry
model TdsEntry {
  id            String   @id @default(cuid())
  orgId         String
  partyName     String
  pan           String
  section       String   // 194C, 194J, 194H, 194I
  amount        Float    // base amount
  tdsRate       Float    // percentage
  tdsAmount     Float    // deducted amount
  date          String
  invoiceRef    String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orgId, section])
}

/// Budget — category-wise spending limit for an organization
model Budget {
  id          String   @id @default(cuid())
  orgId       String
  category    String
  amount      Float
  period      String   @default("monthly") // monthly, quarterly, annual
  startDate   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orgId, category])
}

model Batch {
  id              String    @id @default(cuid())
  orgId           String
  productId       String
  batchNumber     String
  quantity        Float     @default(0)
  expiryDate      DateTime?
  manufactureDate DateTime?
  costPrice       Float     @default(0)
  status          String    @default("active") // active, expired, recalled
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([orgId, batchNumber])
  @@index([orgId])
  @@index([productId])
  @@index([expiryDate])
}

model Document {
  id         String   @id @default(cuid())
  orgId      String
  entityType String   // invoice, order, party, product, payment
  entityId   String
  fileName   String
  fileUrl    String
  fileType   String   @default("application/octet-stream")
  fileSize   Int      @default(0)
  uploadedBy String?
  createdAt  DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, entityType, entityId])
  @@index([orgId])
}
