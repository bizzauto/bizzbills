generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  ACCOUNTANT
  SALES_MANAGER
  VIEWER
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

/// NextAuth models — extended with orgId for multi-tenancy
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orgId String?
  role  Role          @default(VIEWER)
  org   Organization? @relation(fields: [orgId], references: [id])

  accounts    Account[]
  sessions    Session[]
  invoices    Invoice[]
  tenantUsers TenantUser[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Multi-tenant organization model
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  currency  String   @default("INR")
  gstin     String?
  address   String?
  phone     String?
  email     String?
  website   String?
  upiId     String?
  plan      String   @default("free")
  settings  String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches        Branch[]
  tenants         TenantUser[]
  invoices        Invoice[]
  subscriptions   Subscription[]
  plans           Plan[]
  users           User[]
  chartOfAccounts ChartOfAccount[]
  journalEntries  JournalEntry[]
  ledgers         Ledger[]
  gstRates        GstRate[]
  ewayBills       EwayBill[]
  hsnSacCodes     HsnSacCode[]
  aiConfig        AIConfig?
  exchangeRates   CurrencyExchangeRate[]
  payments        Payment[]
  creditNotes     CreditNote[]
  debitNotes      DebitNote[]
  recurringInvoices RecurringInvoice[]
  reminderSetting ReminderSetting?
  products        Product[]
  warehouses      Warehouse[]
  inventoryItems  InventoryItem[]
  stockMovements  StockMovement[]
}

/// Branch/location within an organization
model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String?
  city      String?
  state     String?
  pincode   String?
  gstin     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  invoices Invoice[]

  @@index([orgId])
}

/// TenantUser links a User to an Organization with a specific role
model TenantUser {
  id       String   @id @default(cuid())
  userId   String
  orgId    String
  role     Role     @default(VIEWER)
  joinedAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

/// Subscription plan definition
model Plan {
  id           String   @id @default(cuid())
  orgId        String
  name         String
  price        Float    @default(0)
  billingCycle String   @default("monthly") // monthly, annual
  features     String   @default("[]") // JSON array of feature names
  maxUsers     Int      @default(1)
  maxOrgs      Int      @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

/// Active subscription for an organization
model Subscription {
  id                 String    @id @default(cuid())
  orgId              String
  planId             String
  status             String    @default("active") // active, past_due, cancelled, trial
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  startedAt          DateTime  @default(now())
  endedAt            DateTime?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

/// Application models — org-scoped
model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String
  customerName  String
  customerGstin String   @default("")
  currency      String   @default("INR")
  dueDate       String
  status        String   @default("draft")
  subtotal      Float    @default(0)
  taxTotal      Float    @default(0)
  total         Float    @default(0)
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId    String?
  org      Organization?    @relation(fields: [orgId], references: [id])
  branchId String?
  branch   Branch?          @relation(fields: [branchId], references: [id])
  ewayBillId String?
  payments   Payment[]
  lines    InvoiceLine[]
  versions InvoiceVersion[]
  creditNotes CreditNote[]
  debitNotes  DebitNote[]

  @@index([userId])
  @@index([orgId])
  @@index([branchId])
}

model InvoiceLine {
  id          String @id @default(cuid())
  description String
  quantity    Float
  unitPrice   Float
  taxRate     Float  @default(0)
  hsnCode     String  @default("")

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model InvoiceVersion {
  id            String   @id @default(cuid())
  version       Int
  snapshot      String
  changeComment String   @default("")
  createdAt     DateTime @default(now())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, version])
  @@index([invoiceId])
}

/// Double-entry bookkeeping models

/// Chart of accounts — the complete list of accounts for an organization
model ChartOfAccount {
  id        String      @id @default(cuid())
  orgId     String
  code      String
  name      String
  type      AccountType
  parentId  String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  org            Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent         ChartOfAccount?    @relation("AccountHierarchy", fields: [parentId], references: [id])
  children       ChartOfAccount[]   @relation("AccountHierarchy")
  journalEntries JournalEntryLine[]
  ledgerEntries  Ledger[]

  @@unique([orgId, code])
  @@index([orgId])
  @@index([parentId])
}

/// A journal entry — the core double-entry transaction record
model JournalEntry {
  id          String   @id @default(cuid())
  orgId       String
  entryNumber String
  date        DateTime
  description String
  reference   String?
  isPosted    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org     Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lines   JournalEntryLine[]
  ledgers Ledger[]

  @@index([orgId])
  @@index([orgId, date])
}

/// A single line within a journal entry (debit or credit)
model JournalEntryLine {
  id             String   @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Float    @default(0)
  credit         Float    @default(0)
  description    String   @default("")
  createdAt      DateTime @default(now())

  journalEntry JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      ChartOfAccount @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
}

/// Running balance ledger for each account
model Ledger {
  id             String   @id @default(cuid())
  orgId          String
  accountId      String
  entryDate      DateTime
  JournalEntryId String?
  description    String   @default("")
  debit          Float    @default(0)
  credit         Float    @default(0)
  balance        Float    @default(0)
  createdAt      DateTime @default(now())

  org          Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account      ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry?  @relation(fields: [JournalEntryId], references: [id])

  @@index([orgId])
  @@index([accountId])
  @@index([orgId, accountId, entryDate])
}

/// GST compliance models

/// Configurable GST rates for the organization
model GstRate {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  rate      Float
  type      String   @default("sgst")
  state     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@index([orgId])
}

/// E-Way Bill (Electronic Way Bill) for GST transit
model EwayBill {
  id            String   @id @default(cuid())
  orgId         String
  invoiceId     String?  @unique
  ewbNumber     String   @unique
  ewbDate       DateTime
  fromAddress   String
  toAddress     String
  transportMode String   @default("road")
  vehicleNumber String?
  distance      Float    @default(0)
  status        String   @default("generated")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

/// HSN/SAC code catalog for GST classification
model HsnSacCode {
  id          String   @id @default(cuid())
  orgId       String
  code        String
  description String
  type        String   @default("hsn")
  taxRate     Float
  chapter     String?
  heading     String?
  subheading  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, code])
  @@index([orgId])
  @@index([orgId, type])
}

/// Encrypted AI provider configurations per organization
model AIConfig {
  id        String   @id @default(cuid())
  orgId     String   @unique
  provider  String   @default("openai") // openai | anthropic
  apiKeyEncrypted String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

/// Exchange rates for multi-currency support
model CurrencyExchangeRate {
  id        String   @id @default(cuid())
  orgId     String
  fromCurrency String @default("INR")
  toCurrency   String
  rate      Float
  date      DateTime @default(now())
  source    String   @default("manual") // manual | api
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, fromCurrency, toCurrency])
  @@index([orgId])
}

/// Recurring invoice — auto-generate invoices on a schedule
model RecurringInvoice {
  id              String   @id @default(cuid())
  orgId           String
  customerName    String
  customerGstin   String   @default("")
  currency        String   @default("INR")
  frequency       String   @default("monthly") // daily, weekly, monthly, quarterly, yearly
  interval        Int      @default(1)
  startDate       DateTime
  endDate         DateTime?
  nextRunDate     DateTime
  lastRunAt       DateTime?
  status          String   @default("active") // active, paused, completed, cancelled
  subtotal        Float    @default(0)
  taxTotal        Float    @default(0)
  total           Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  lines       RecurringInvoiceLine[]
  invoiceIds  String @default("[]") // JSON array of generated invoice IDs

  @@index([orgId])
  @@index([orgId, status])
  @@index([nextRunDate])
}

model RecurringInvoiceLine {
  id          String @id @default(cuid())
  description String
  quantity    Float
  unitPrice   Float
  taxRate     Float  @default(0)
  hsnCode     String @default("")

  recurringInvoiceId String
  recurringInvoice   RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)

  @@index([recurringInvoiceId])
}

/// Product master catalog for inventory
model Product {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  description String   @default("")
  sku         String   @default("")
  hsnCode     String   @default("")
  unit        String   @default("pcs") // pcs, kg, meter, box, etc.
  sellingPrice Float   @default(0)
  purchasePrice Float  @default(0)
  taxRate     Float    @default(0)
  category    String   @default("")
  brand       String   @default("")
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org        Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  inventory  InventoryItem[]
  movements  StockMovement[]

  @@unique([orgId, sku])
  @@index([orgId])
  @@index([orgId, category])
}

/// Warehouse / storage location
model Warehouse {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  address   String   @default("")
  city      String   @default("")
  state     String   @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org       Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  inventory InventoryItem[]
  stockMovements StockMovement[]

  @@unique([orgId, name])
  @@index([orgId])
}

/// Stock level per product per warehouse
model InventoryItem {
  id          String   @id @default(cuid())
  orgId       String
  productId   String
  warehouseId String
  quantity    Float    @default(0)
  minStock    Float    @default(0) // low-stock threshold
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([orgId, productId, warehouseId])
  @@index([orgId])
  @@index([productId])
  @@index([warehouseId])
}

/// Stock movement log (in/out/transfer/adjustment)
model StockMovement {
  id          String   @id @default(cuid())
  orgId       String
  productId   String
  warehouseId String
  type        String   @default("in") // in, out, transfer, adjustment
  quantity    Float
  reference   String   @default("") // invoice number, order number, etc.
  notes       String   @default("")
  createdAt   DateTime @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse    @relation(fields: [warehouseId], references: [id])

  @@index([orgId])
  @@index([productId])
  @@index([warehouseId])
  @@index([createdAt])
}

/// Reminder configuration for overdue invoices
model ReminderSetting {
  id               String   @id @default(cuid())
  orgId            String   @unique
  enabled          Boolean  @default(true)
  daysBefore       Int      @default(3)
  sendToCustomer   Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}
model Payment {
  id              String   @id @default(cuid())
  orgId           String
  invoiceId       String?
  amount          Float
  currency        String   @default("INR")
  method          String   @default("upi") // upi, bank_transfer, cash, cheque, card, gateway
  status          String   @default("pending") // pending, completed, failed, refunded
  gatewayRef      String?  // Razorpay/Stripe payment ID
  upiTransactionId String?
  notes           String?
  paidAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoice Invoice?     @relation(fields: [invoiceId], references: [id])

  @@index([orgId])
  @@index([invoiceId])
}

/// Credit note — sales return / credit to customer
model CreditNote {
  id              String   @id @default(cuid())
  creditNoteNumber String
  orgId           String
  invoiceId       String?
  customerName    String
  customerGstin   String   @default("")
  currency        String   @default("INR")
  reason          String   @default("return")
  subtotal        Float    @default(0)
  taxTotal        Float    @default(0)
  total           Float    @default(0)
  status          String   @default("draft")
  date            DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org     Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoice Invoice?      @relation(fields: [invoiceId], references: [id])

  lines    CreditNoteLine[]

  @@index([orgId])
  @@index([invoiceId])
}

model CreditNoteLine {
  id          String @id @default(cuid())
  description String
  quantity    Float
  unitPrice   Float
  taxRate     Float  @default(0)
  hsnCode     String @default("")

  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@index([creditNoteId])
}

/// Debit note — purchase return / debit from supplier
model DebitNote {
  id            String   @id @default(cuid())
  debitNoteNumber String
  orgId         String
  invoiceId     String?
  supplierName  String
  supplierGstin String   @default("")
  currency      String   @default("INR")
  reason        String   @default("return")
  subtotal      Float    @default(0)
  taxTotal      Float    @default(0)
  total         Float    @default(0)
  status        String   @default("draft")
  date          DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org     Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoice Invoice?      @relation(fields: [invoiceId], references: [id])

  lines    DebitNoteLine[]

  @@index([orgId])
  @@index([invoiceId])
}

model DebitNoteLine {
  id          String @id @default(cuid())
  description String
  quantity    Float
  unitPrice   Float
  taxRate     Float  @default(0)
  hsnCode     String @default("")

  debitNoteId String
  debitNote   DebitNote @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)

  @@index([debitNoteId])
}
